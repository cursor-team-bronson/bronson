# If both repo-root `.env` and this file exist, this file wins for duplicate keys.
PORT=3001
# When PORT is busy, try PORT+1 … up to this many attempts (default 1 = no fallback).
# BRONSON_LISTEN_PORT_TRIES=5
# Skip killing whatever holds PORT before `npm run dev` (default: kill listeners on PORT).
# BRONSON_SKIP_FREE_PORT=1
CLOD_API_KEY=your_clod_api_key_here
CLOD_BASE_URL=https://api.clod.io/v1

# Default model when a job omits `model:` — must match the provider exactly (CLōD docs use quoted names with spaces).
# CLōD example: "DeepSeek V3" → use quotes in .env:
# DEFAULT_AGENT_MODEL="DeepSeek V3"
# CLOD_DEFAULT_MODEL="DeepSeek V3"

# Shell tool (YAML tools: [shell]) — off unless explicitly enabled (dangerous).
ALLOW_SHELL_TOOL=false

# Essay UI test (examples/essay-write-review-3cycles.yaml): set ALLOW_SHELL_TOOL=true and point
# TOOL_SHELL_CWD at the same folder as paths in that YAML (see file header). Optionally set
# TOOL_SHELL_ALLOWLIST_REGEX (e.g. ^powershell for PowerShell-only writes).

# Optional guards when ALLOW_SHELL_TOOL=true:
# Working directory for shell commands (where bronson-shell-proof.txt lands in examples/shell-write-local.yaml).
# TOOL_SHELL_CWD=C:/path/to/bronson/examples
# TOOL_SHELL_TIMEOUT_MS=60000
# TOOL_SHELL_MAX_OUTPUT_BYTES=131072
# TOOL_SHELL_ALLOWLIST_REGEX=^echo\s

# Per-job budget_usd (YAML): costs deduct after each LLM round; over limit opens AllScale checkout or pauses.
# If checkout creation fails (missing ALLSCALE_* keys, network), the job fails immediately by default
# with a clear error (no 1h funding wait). To pause until manual top-up API instead:
# BRONSON_BUDGET_ON_EXCEED=await_funding

# AllScale — payment layer for budget top-ups and bet funding
# Get keys at https://allscale.io/dashboard
ALLSCALE_BASE_URL=https://api.allscale.io
ALLSCALE_API_KEY=your_allscale_api_key_here
ALLSCALE_API_SECRET=your_allscale_api_secret_here

# Model used by the meta-agent to generate workflow YAML (defaults to gpt-4o)
META_AGENT_MODEL=gpt-4o

# Shared secret between the AllScale webhook handler and the orchestrator.
# When set, POST /runs/:id/jobs/:id/fund requires X-Internal-Secret header.
# INTERNAL_API_SECRET=some-random-secret
