# If both repo-root `.env` and this file exist, this file wins for duplicate keys.
PORT=3001
# When PORT is busy, try PORT+1 … up to this many attempts (default 1 = no fallback).
# BRONSON_LISTEN_PORT_TRIES=5
# Skip killing whatever holds PORT before `npm run dev` (default: kill listeners on PORT).
# BRONSON_SKIP_FREE_PORT=1
CLOD_API_KEY=your_clod_api_key_here
CLOD_BASE_URL=https://api.clod.io/v1

# Default model when a job omits `model:` — must match the provider exactly (CLōD docs use quoted names with spaces).
# Required unless every job sets `model:` in YAML. CLōD example:
DEFAULT_AGENT_MODEL="DeepSeek V3"
# CLOD_DEFAULT_MODEL="DeepSeek V3"

# Shell tool (YAML tools: [shell]) — off unless explicitly enabled (dangerous).
ALLOW_SHELL_TOOL=false

# Essay / Model runner “Load essay test” preset (tools: [shell]): set both lines and use an absolute path.
# ALLOW_SHELL_TOOL=true
# TOOL_SHELL_CWD=/absolute/path/to/bronson/examples/essay-workspace
# Writers use the file name essay-draft.txt relative to TOOL_SHELL_CWD (see examples/essay-write-review-3cycles.yaml).
# Optional: TOOL_SHELL_ALLOWLIST_REGEX (e.g. ^powershell or broader dev-only .*)

# Optional guards when ALLOW_SHELL_TOOL=true:
# Working directory for shell commands (where bronson-shell-proof.txt lands in examples/shell-write-local.yaml).
# TOOL_SHELL_CWD=C:/path/to/bronson/examples
# TOOL_SHELL_TIMEOUT_MS=60000
# TOOL_SHELL_MAX_OUTPUT_BYTES=131072
# TOOL_SHELL_ALLOWLIST_REGEX=^echo\s

# Optional: persist each job’s output to Supabase for retry after failure / orchestrator restart.
# Use the project URL and service_role key (Dashboard → Settings → API). Never expose service_role to the browser.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# (Fallback: NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY)
# Retry API: POST /api/runs/:runId/jobs/:jobId/retry
